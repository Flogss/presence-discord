# === Obligatoire ===
# Token de TON compte Discord (selfbot). A mettre dans Railway > Variables.
DISCORD_TOKEN=

# ID de l'application Discord (https://discord.com/developers/applications).
# Le NOM de cette application est ce qui s'affiche en gros sur ton profil.
# Nomme-la "Stake" pour avoir "Joue a Stake".
APPLICATION_ID=

# === Contenu de la presence (optionnel, valeurs par defaut ci-dessous) ===
ACTIVITY_NAME=Stake
ACTIVITY_DETAILS=Blackjack
ACTIVITY_STATE=Table VIP - stake.com

# Bouton affiche sur le profil
BUTTON_LABEL=Jouer avec moi
BUTTON_URL=https://stake.com/fr

# Logo (URL publique d'une image, proxyfiee automatiquement par Discord)
LARGE_IMAGE_URL=https://stake.com/apple-touch-icon.png
LARGE_IMAGE_TEXT=Stake.com
# Petite image en bas a droite (optionnel)
SMALL_IMAGE_URL=
SMALL_IMAGE_TEXT=Blackjack

# Statut affiche : online | idle | dnd | invisible
STATUS=online

# Port du healthcheck HTTP (Railway le fournit automatiquement)
PORT=3000
